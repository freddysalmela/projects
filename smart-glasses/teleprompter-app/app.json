{
  "expo": {
    "name": "Teleprompter",
    "slug": "teleprompter-glasses",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0a0a0f"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.teleprompterglasses.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Teleprompter uses the microphone to sync scroll speed to your speaking pace."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0a0a0f"
      },
      "package": "com.teleprompterglasses.app",
      "permissions": [
        "RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-av",
        {
          "microphonePermission": "Teleprompter uses the microphone to sync scroll speed to your speaking pace."
        }
      ]
    ]
  }
}
