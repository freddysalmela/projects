[Unit]
Description=Gaia Gateway — wake word listener
After=network.target sound.target

[Service]
ExecStart=/usr/bin/python3 /home/pi/projects/booster/pi_gateway/main.py
WorkingDirectory=/home/pi/projects/booster/pi_gateway
Restart=on-failure
RestartSec=5
User=pi
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
